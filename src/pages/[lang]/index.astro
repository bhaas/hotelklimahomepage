---
import { Image, getImage } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { legalContent, legalPath } from '../../data/legal';
import { bookingContent, bookingEmail } from '../../data/booking';
import { hotelImages, locales, siteContent, type Locale } from '../../data/site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = siteContent[lang];
const legal = legalContent[lang];
const booking = bookingContent[lang];

if (!page) {
  throw new Error(`Unsupported language: ${Astro.params.lang}`);
}

const switcher = locales.map((item) => ({
  code: item,
  label: item.toUpperCase(),
  href: `/${item}/`,
}));

const sectionIds = {
  de: {
    hotel: 'hotel',
    rooms: 'zimmer',
    prices: 'preise',
    taste: 'genuss',
    region: 'region',
    contact: 'kontakt',
    gallery: 'galerie',
  },
  en: {
    hotel: 'hotel',
    rooms: 'rooms',
    prices: 'prices',
    taste: 'taste',
    region: 'region',
    contact: 'contact',
    gallery: 'gallery',
  },
  it: {
    hotel: 'hotel',
    rooms: 'camere',
    prices: 'prezzi',
    taste: 'gusto',
    region: 'territorio',
    contact: 'contatti',
    gallery: 'galleria',
  },
} as const;

const ids = sectionIds[lang];

const hreflangCodes = { de: 'de', en: 'en', it: 'it' } as const;
const ogLocales = { de: 'de_AT', en: 'en_GB', it: 'it_IT' } as const;
const alternates = locales.map((item) => ({ lang: hreflangCodes[item], path: `/${item}/` }));

const ogImage = await getImage({
  src: hotelImages.winterPanorama,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});

const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(`/${lang}/`, site).href;
const lowestHalfBoard = Math.min(
  ...page.pricing.rows.map((row) => Number(row.halfBoard.replace(/[^\d]/g, ''))),
);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  '@id': new URL('/#hotel', site).href,
  name: 'Hotel Klima',
  alternateName: 'Hotel Klima Ferienoase',
  url: pageUrl,
  description: page.meta.description,
  inLanguage: lang,
  logo: new URL('/logo-klima-512.png', site).href,
  image: [new URL(ogImage.src, site).href],
  telephone: '+43 5226 2526',
  email: 'haas@hotel-klima.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Pinnisweg 53',
    postalCode: '6167',
    addressLocality: 'Neustift im Stubaital',
    addressRegion: 'Tirol',
    addressCountry: 'AT',
  },
  hasMap: page.contact.map.href,
  geo: { '@type': 'GeoCoordinates', latitude: 47.11692, longitude: 11.32607 },
  checkinTime: '13:00',
  checkoutTime: '10:00',
  petsAllowed: false,
  paymentAccepted: 'Cash, Bank transfer',
  sameAs: ['https://www.hotel-klima.at/', 'https://www.hotel-klima.info/'],
  priceRange: `ab € ${lowestHalfBoard} p. P. (Halbpension)`,
  currenciesAccepted: 'EUR',
  smokingAllowed: false,
  availableLanguage: ['de', 'en', 'it'],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Free Wi-Fi', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free parking', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Elevator', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Electric vehicle charging station', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Sauna', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Steam bath', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Infrared cabin', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Restaurant / half board', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Ski bus stop opposite the hotel', value: true },
  ],
  containedInPlace: { '@type': 'Place', name: 'Stubaital, Tirol, Österreich' },
};
---

<MainLayout
  title={page.meta.title}
  description={page.meta.description}
  locale={lang}
  alternates={alternates}
  ogImage={ogImage.src}
  ogLocale={ogLocales[lang]}
  structuredData={structuredData}
>
  <div class="page-shell">
    <div class="site-frame">
      <header class="site-header">
        <div class="header-bar">
          <a class="brand" href={`/${lang}/`} translate="no">
            <img class="brand__logo" src="/logo-klima.svg" alt="Hotel Klima – Hotel · Stubaital" width="362" height="125" />
          </a>

          <nav class="nav" aria-label={page.languageName}>
            {page.nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>

          <div class="header-actions">
          <a class="button header-cta" href="#anfrage">{page.contact.title}</a>

          <div class="language-switcher notranslate" aria-label="Languages" translate="no">
            {switcher.map((item) => (
              <a
                href={item.href}
                lang={item.code}
                hreflang={item.code}
                translate="no"
                aria-current={item.code === lang ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
          </div>
        </div>
      </header>

      <main>
        <section class:list={['hero', page.hero.imageKey === 'winterPanorama' && 'hero--panorama']}>
          <div class="hero__media">
            <Image
              src={hotelImages[page.hero.imageKey]}
              alt={page.hero.imageAlt}
              widths={[960, 1440, 2000]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="hero__overlay"></div>
          <div class="hero__content">
            <div class="hero__panel">
              <span class="eyebrow">{page.hero.eyebrow}</span>
              <h1>{page.hero.title}</h1>
              <p class="hero__lead">{page.hero.description}</p>
              <div class="hero__actions">
                {page.hero.ctas.map((cta) => (
                  <a class:list={['button', cta.primary ? 'button--primary' : 'button--secondary']} href={cta.href}>
                    {cta.label}
                  </a>
                ))}
              </div>
              <ul class="pill-list">
                {page.hero.facts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <section class="section" id={ids.hotel}>
          <div class="section-card section-card--padded split">
            <div class="intro-copy">
              <div class="section-heading">
                <h2>{page.intro.title}</h2>
                <p>{page.intro.text}</p>
              </div>

              <div class="stats">
                {page.intro.stats.map((stat) => (
                  <div class="stat">
                    <span class="stat__value">{stat.value}</span>
                    <span class="stat__label">{stat.label}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="photo-frame">
              <Image
                src={hotelImages[page.intro.imageKey]}
                alt={page.intro.imageAlt}
                widths={[720, 1080, 1440]}
                sizes="(max-width: 1080px) 100vw, 45vw"
              />
            </div>
          </div>
        </section>

        <section class="section">
          <div class="section-heading">
            <h2>{page.highlights.title}</h2>
          </div>

          <div class="feature-grid">
            {page.highlights.items.map((item) => (
              <article class="card card--padding">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="section" id={ids.rooms}>
          <div class="section-card section-card--padded split">
            <div>
              <div class="section-heading">
                <h2>{page.rooms.title}</h2>
                <p>{page.rooms.text}</p>
              </div>

              <ul class="check-list">
                {page.rooms.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>

              <div class="info-note">{page.rooms.note}</div>
            </div>

            <div class="photo-frame">
              <Image
                src={hotelImages[page.rooms.imageKey]}
                alt={page.rooms.imageAlt}
                widths={[720, 1080, 1600]}
                sizes="(max-width: 1080px) 100vw, 42vw"
              />
            </div>
          </div>
        </section>

        <section class="section" id={ids.prices}>
          <div class="section-card section-card--padded">
            <div class="section-heading">
              <h2>{page.pricing.title}</h2>
            </div>

            <div class="table-wrap">
              <table class="pricing-table">
                <thead>
                  <tr>
                    <th>{page.pricing.columns.period}</th>
                    <th>{page.pricing.columns.halfBoard}</th>
                    <th>{page.pricing.columns.bedBreakfast}</th>
                  </tr>
                </thead>
                <tbody>
                  {page.pricing.rows.map((row) => (
                    <tr>
                      <td>{row.period}</td>
                      <td>{row.halfBoard}</td>
                      <td>{row.bedBreakfast}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <ul class="pricing-notes">
              {page.pricing.footnotes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </div>
        </section>

        <section class="section" id={ids.taste}>
          <div class="section-heading">
            <h2>{page.experience.title}</h2>
          </div>

          <div class="experience-grid">
            {page.experience.cards.map((card) => (
              <article class="card">
                <div class="card__media">
                  <Image
                    src={hotelImages[card.imageKey]}
                    alt={card.imageAlt}
                    widths={[720, 1080, 1440]}
                    sizes="(max-width: 1080px) 100vw, 48vw"
                  />
                </div>
                <div class="card__body">
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                  <ul class="check-list">
                    {card.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="section" id={ids.region}>
          <div class="section-card section-card--padded">
            <div class="section-heading">
              <h2>{page.region.title}</h2>
              <p>{page.region.text}</p>
            </div>

            <div class="season-grid">
              {page.region.seasons.map((season) => (
                <article class="card">
                  <div class="card__media">
                    <Image
                      src={hotelImages[season.imageKey]}
                      alt={season.imageAlt}
                      widths={[720, 1080, 1440]}
                      sizes="(max-width: 1080px) 100vw, 48vw"
                    />
                  </div>
                  <div class="card__body">
                    <h3>{season.title}</h3>
                    <ul class="season-list">
                      {season.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))}
            </div>

            <a class="elfer-tip" href={page.region.elferTip.href} target="_blank" rel="noreferrer">
              <div class="elfer-tip__images">
                {page.region.elferTip.images.map((image) => (
                  <div class="elfer-tip__image">
                    <Image
                      src={hotelImages[image.key]}
                      alt={image.alt}
                      widths={[720, 1080, 1440]}
                      sizes="(max-width: 1080px) 100vw, 45vw"
                    />
                  </div>
                ))}
              </div>
              <div class="elfer-tip__content">
                <span class="elfer-tip__label">{page.region.elferTip.label}</span>
                <h3>{page.region.elferTip.title}</h3>
                <p>{page.region.elferTip.text}</p>
                <span class="elfer-tip__link">{page.region.elferTip.linkLabel} <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          </div>
        </section>

        <section class="section" id={ids.gallery}>
          <div class="section-card section-card--padded">
            <div class="section-heading">
              <h2>{page.gallery.title}</h2>
              <p>{page.gallery.text}</p>
            </div>

            <div class="gallery-grid">
              {page.gallery.items.map((item) => (
                <div class="card">
                  <div class="card__media">
                    <Image
                      src={hotelImages[item.key]}
                      alt={item.alt}
                      widths={[520, 720, 960]}
                      sizes="(max-width: 1080px) 100vw, 30vw"
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="section" id="info">
          <div class="section-card section-card--padded">
            <div class="section-heading">
              <h2>{booking.practical.title}</h2>
              <p>{booking.practical.text}</p>
            </div>
            <dl class="practical-grid">
              {booking.practical.items.map((item) => (
                <div class="practical-item">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>

        <section class="section" id={ids.contact}>
          <div class="section-card contact-card">
            <div class="contact-panel contact-copy">
              <div class="section-heading">
                <h2>{page.contact.title}</h2>
                <p>{page.contact.text}</p>
              </div>

              <ul class="address-list">
                {page.contact.addressLines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>

              <div class="contact-links">
                <a class="contact-link" href={page.contact.phoneHref}>
                  {page.contact.phoneLabel}
                </a>
                <a class="contact-link" href={page.contact.emailHref}>
                  {page.contact.emailLabel}
                </a>
              </div>

              <form
                class="booking-form"
                id="anfrage"
                action={`mailto:${bookingEmail}`}
                method="post"
                enctype="text/plain"
                data-email={bookingEmail}
                data-subject={booking.form.subject}
                data-date-error={booking.form.dateError}
              >
                <h3>{booking.form.title}</h3>
                <p class="booking-form__intro">{booking.form.intro}</p>

                <div class="booking-form__grid">
                  <label class="field field--wide">
                    <span>{booking.form.name}</span>
                    <input name={booking.form.name} autocomplete="name" required />
                  </label>
                  <label class="field">
                    <span>{booking.form.email}</span>
                    <input type="email" name={booking.form.email} autocomplete="email" required />
                  </label>
                  <label class="field">
                    <span>{booking.form.phone} <small>({booking.form.optional})</small></span>
                    <input type="tel" name={booking.form.phone} autocomplete="tel" />
                  </label>
                  <label class="field">
                    <span>{booking.form.arrival}</span>
                    <input type="date" name={booking.form.arrival} data-role="arrival" required />
                  </label>
                  <label class="field">
                    <span>{booking.form.departure}</span>
                    <input type="date" name={booking.form.departure} data-role="departure" required />
                  </label>
                  <label class="field">
                    <span>{booking.form.adults}</span>
                    <input type="number" name={booking.form.adults} min="1" max="20" value="2" required />
                  </label>
                  <label class="field">
                    <span>{booking.form.children}</span>
                    <input type="number" name={booking.form.children} min="0" max="20" value="0" />
                  </label>
                  <label class="field field--wide">
                    <span>{booking.form.childAges} <small>({booking.form.optional})</small></span>
                    <input name={booking.form.childAges} placeholder={booking.form.childAgesPlaceholder} />
                  </label>
                  <label class="field">
                    <span>{booking.form.room}</span>
                    <select name={booking.form.room}>
                      {booking.form.rooms.map((room) => <option>{room}</option>)}
                    </select>
                  </label>
                  <label class="field">
                    <span>{booking.form.board}</span>
                    <select name={booking.form.board}>
                      {booking.form.boards.map((board) => <option>{board}</option>)}
                    </select>
                  </label>
                  <label class="field field--wide">
                    <span>{booking.form.message} <small>({booking.form.optional})</small></span>
                    <textarea name={booking.form.message} rows="4"></textarea>
                  </label>
                </div>

                <button type="submit" class="button booking-form__submit">{booking.form.submit}</button>
                <p class="booking-form__note">
                  {booking.form.note} <a href={legalPath(lang, 'privacy')}>{booking.form.privacyLabel}</a>
                </p>

                <div class="booking-send" data-role="send" hidden tabindex="-1" aria-live="polite">
                  <h4>{booking.form.send.title}</h4>
                  <p>{booking.form.send.intro}</p>
                  <div class="booking-send__actions">
                    <a class="button" href="#anfrage" data-send="gmail" target="_blank" rel="noopener">{booking.form.send.gmail}</a>
                    <a class="button" href="#anfrage" data-send="outlook" target="_blank" rel="noopener">{booking.form.send.outlook}</a>
                    <a class="button" href="#anfrage" data-send="app">{booking.form.send.app}</a>
                    <button type="button" class="button" data-send="copy">{booking.form.send.copy}</button>
                  </div>
                  <p class="booking-send__copied" data-role="copied" hidden>{booking.form.send.copied}</p>
                </div>
              </form>
            </div>

            <div class="contact-side">
              <article class="card">
                <div class="card__media">
                  <Image
                    src={hotelImages.heroWinter}
                    alt={page.intro.imageAlt}
                    widths={[720, 1080, 1440]}
                    sizes="(max-width: 1080px) 100vw, 40vw"
                  />
                </div>
                <div class="card__body">
                  <h3>Hotel Klima</h3>
                </div>
              </article>

              <article class="card">
                <div class="map-embed map-consent" data-src={page.contact.map.embedSrc} data-title={page.contact.map.embedTitle}>
                  <div class="map-consent__box">
                    <p>{legal.map.consentText}</p>
                    <button type="button" class="button map-consent__button">{legal.map.loadLabel}</button>
                    <a class="map-consent__privacy" href={legalPath(lang, 'privacy')}>{legal.pages.privacy.title}</a>
                  </div>
                </div>
                <div class="card__body">
                  <h3>{page.contact.map.title}</h3>
                  <p>{page.contact.map.text}</p>
                  <div class="contact-links">
                    <a class="contact-link" href={page.contact.map.href} target="_blank" rel="noreferrer">
                      {page.contact.map.linkLabel}
                    </a>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </section>
      </main>
      <SiteFooter lang={lang} />
    </div>
  </div>
</MainLayout>

<script>
  document.querySelectorAll<HTMLElement>('.map-consent').forEach((container) => {
    container.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = container.dataset.src ?? '';
      iframe.title = container.dataset.title ?? '';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      container.replaceChildren(iframe);
      container.classList.remove('map-consent');
    });
  });

  document.querySelectorAll<HTMLFormElement>('.booking-form').forEach((form) => {
    const arrival = form.querySelector<HTMLInputElement>('[data-role="arrival"]');
    const departure = form.querySelector<HTMLInputElement>('[data-role="departure"]');
    const today = new Date().toISOString().slice(0, 10);
    if (arrival && departure) {
      arrival.min = today;
      departure.min = today;
      arrival.addEventListener('change', () => {
        departure.min = arrival.value || today;
        departure.setCustomValidity('');
      });
      departure.addEventListener('change', () => departure.setCustomValidity(''));
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (arrival && departure && arrival.value && departure.value && departure.value <= arrival.value) {
        departure.setCustomValidity(form.dataset.dateError ?? '');
        departure.reportValidity();
        return;
      }
      if (!form.reportValidity()) return;

      const formatDate = (value: string) => value.split('-').reverse().join('.');
      const lines = [...new FormData(form).entries()]
        .filter(([, value]) => String(value).trim() !== '')
        .map(([key, value]) => {
          const input = form.elements.namedItem(key) as HTMLInputElement | null;
          return `${key}: ${input?.type === 'date' ? formatDate(String(value)) : value}`;
        });
      const subject = `${form.dataset.subject} ${arrival ? formatDate(arrival.value) : ''}–${departure ? formatDate(departure.value) : ''}`;
      const body = lines.join('\n');
      const to = form.dataset.email ?? '';
      const q = (value: string) => encodeURIComponent(value);
      const links: Record<string, string> = {
        gmail: `https://mail.google.com/mail/?view=cm&fs=1&to=${q(to)}&su=${q(subject)}&body=${q(body)}`,
        outlook: `https://outlook.live.com/mail/0/deeplink/compose?to=${q(to)}&subject=${q(subject)}&body=${q(body)}`,
        app: `mailto:${to}?subject=${q(subject)}&body=${q(body)}`,
      };
      form.querySelectorAll<HTMLAnchorElement>('a[data-send]').forEach((link) => {
        link.href = links[link.dataset.send ?? ''] ?? '#';
      });
      const copyButton = form.querySelector<HTMLButtonElement>('[data-send="copy"]');
      const copied = form.querySelector<HTMLElement>('[data-role="copied"]');
      if (copyButton) {
        copyButton.onclick = async () => {
          const text = `${to}\n${subject}\n\n${body}`;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            window.prompt('', text);
          }
          if (copied) copied.hidden = false;
        };
      }
      if (copied) copied.hidden = true;
      const panel = form.querySelector<HTMLElement>('[data-role="send"]');
      if (panel) {
        panel.hidden = false;
        panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        panel.focus({ preventScroll: true });
      }
    });
  });
</script>
